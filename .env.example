# Project / server
PROJECT_ROOT=
HOST=127.0.0.1
PORT=4444

# GPU / OCR
GPU_INDEX=0
REQUIRE_CUDA=true
DET_DIR=Models/PP-OCRv6_medium_det_infer
REC_DIR=Models/PP-OCRv6_medium_rec_infer
LAYOUT_DIR=Models/PP-DocLayout_plus-L_infer
DEVICE=gpu

# LLM API protection
LLM_API_TOKEN=
LLM_API_TOKEN_QUERY_KEY=Token

# Hugging Face / local models
LLM_HF_TOKEN=
LLM_HF_HOME=Models
LLM_LOCAL_MODELS_DIR=Models

# Ollama
LLM_USE_OLLAMA=true
OLLAMA_CHAT_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.6
