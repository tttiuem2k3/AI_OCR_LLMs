 def down_arrow(draw, x, y1, y2, color=LINE, width=6, tip=23):
     draw.line((x, y1, x, y2 - tip), fill=color, width=width)
     draw.polygon([(x, y2), (x - tip * 0.64, y2 - tip), (x + tip * 0.64, y2 - tip)], fill=color)
 
