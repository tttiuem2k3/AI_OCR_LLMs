+import json, shutil, zipfile
+from copy import copy
+from datetime import datetime
+from pathlib import Path
+
+from openpyxl import load_workbook
+from openpyxl.styles import PatternFill
+
+ROOT = Path(r"E:\Asoft\AI_BEM\AI_BEM_Check_T08_09")
+BOOK = ROOT / "DATA_BEM AI_MEIKO_30092026.xlsx"
+WORK = ROOT / "Accuracy_Recheck_T09_20261002"
+BACKUP = ROOT / "Archive" / f"{BOOK.stem}_before_t09_accuracy_fix_{datetime.now():%Y%m%d_%H%M%S}.xlsx"
+GREEN, ORANGE, YELLOW = "FF77BC65", "FFFF972F", "FFFFE994"
+POS = ("AI đọc đúng", "AI trả lời đúng", "AI trả lời đúng theo Rules", "AI trả lời tốt")
+NEG = ("AI đọc sai", "AI trả lời sai", "AI đối chiếu sai")
+
+def load_json(name):
+    return json.loads((WORK / name).read_text(encoding="utf-8-sig"))
+
+def pct(value):
+    if value in (None, ""):
+        return None
+    if isinstance(value, (int, float)):
+        return float(value) / 100 if float(value) > 1.0001 else float(value)
+    number = float(str(value).replace("%", "").replace(",", ".").strip())
+    return number / 100 if number > 1.0001 else number
+
+def issue_fill(text):
+    text = str(text or "")
+    if any(label in text for label in NEG):
+        return ORANGE
+    if any(label in text for label in POS) and "Không có kết quả AI" not in text:
+        return GREEN
+    return YELLOW
+
+def positive_only(text):
+    text = str(text or "")
+    return any(label in text for label in POS) and not any(label in text for label in NEG)
+
+def copy_row_style(ws, source_row, target_row):
+    for column in range(1, ws.max_column + 1):
+        source = ws.cell(source_row, column)
+        target = ws.cell(target_row, column)
+        target._style = copy(source._style)
+        target.number_format = source.number_format
+        target.alignment = copy(source.alignment)
+        target.font = copy(source.font)
+        target.fill = copy(source.fill)
+        target.border = copy(source.border)
+        target.protection = copy(source.protection)
+    ws.row_dimensions[target_row].height = ws.row_dimensions[source_row].height
+
+db = load_json("db_t09_latest_20261002.json")["Records"]
+db_by = {str(row["VoucherNo"]): row for row in db}
+special = {row["voucher"]: row for row in load_json("special_review_decisions_t09_20261002.json")}
+missing = load_json("missing_0298_db.json")
+
+shutil.copy2(BOOK, BACKUP)
+wb = load_workbook(BOOK)
+ws = wb["Kết quả tháng 09 và xử lý"]
+row_by = {str(ws.cell(row, 8).value): row for row in range(3, ws.max_row + 1) if ws.cell(row, 8).value}
+
+inserted = []
+if missing["VoucherNo"] not in row_by:
+    row = row_by["NVL/09/2026/0299"]
+    ws.insert_rows(row, 1)
+    copy_row_style(ws, row + 1, row)
+    values = [None, datetime.fromisoformat(missing["CreateDate"]), "Nguyên vật liệu", missing["Nam"], missing["Thang"], missing["CurrencyID"], missing["AdvanceUserID"], missing["VoucherNo"], "OK" if missing["IsVoucherCompleted"] == 1 else "NG", missing["SoFile"], None, None, "OK" if missing.get("ApprovingLevel") == 6 else "NG", None, None, "- Phiếu chưa có kết quả AI OK/NG mới nhất trên DB.\n- Chưa đủ căn cứ để đánh giá AI đọc/đối chiếu đúng hay sai.", "- Không có kết quả AI", "- Cần chạy AI trước khi nghiệm thu phiếu này.", 0, "- DB mới nhất chưa có lần chạy AI hợp lệ."]
+    for column, value in enumerate(values, 1):
+        ws.cell(row, column).value = value
+    ws.cell(row, 19).number_format = "0.00%"
+    ws.cell(row, 17).fill = PatternFill("solid", fgColor=YELLOW)
+    inserted.append(missing["VoucherNo"])
+    row_by = {str(ws.cell(r, 8).value): r for r in range(3, ws.max_row + 1) if ws.cell(r, 8).value}
+
+updated_kl, updated_review, updated_accuracy = set(), [], []
+for voucher, row in row_by.items():
+    current = db_by.get(voucher)
+    if not current:
+        continue
+    new_status = current.get("Status")
+    new_percentage = pct(current.get("Percentage"))
+    if ws.cell(row, 11).value != new_status:
+        ws.cell(row, 11).value = new_status
+        updated_kl.add(voucher)
+    old_percentage = pct(ws.cell(row, 12).value)
+    if (old_percentage is None) != (new_percentage is None) or (old_percentage is not None and new_percentage is not None and abs(old_percentage - new_percentage) > 0.00001):
+        ws.cell(row, 12).value = new_percentage
+        ws.cell(row, 12).number_format = "0.00%"
+        updated_kl.add(voucher)
+
+    if voucher in special:
+        item = special[voucher]
+        for column, key in ((16, "p"), (17, "q"), (18, "r"), (19, "s"), (20, "t")):
+            ws.cell(row, column).value = item[key]
+        ws.cell(row, 19).number_format = "0.00%"
+        ws.cell(row, 17).fill = PatternFill("solid", fgColor=item.get("fill") or issue_fill(item.get("q")))
+        updated_review.append(voucher)
+    else:
+        process = str(current.get("StatusProcess") or "").upper()
+        status = str(current.get("Status") or "").upper()
+        issue = ws.cell(row, 17).value
+        if process == "COMPLETED" and status in ("OK", "NG") and positive_only(issue) and pct(ws.cell(row, 19).value) != 1.0:
+            ws.cell(row, 19).value = 1.0
+            ws.cell(row, 19).number_format = "0.00%"
+            ws.cell(row, 17).fill = PatternFill("solid", fgColor=issue_fill(issue))
+            updated_accuracy.append(voucher)
+
+for row in range(3, ws.max_row + 1):
+    if ws.cell(row, 8).value:
+        ws.cell(row, 1).value = row - 2
+
+wb.save(BOOK)
+with zipfile.ZipFile(BOOK) as archive:
+    names = archive.namelist()
+audit = {
+    "workbook": str(BOOK),
+    "backup": str(BACKUP),
+    "inserted": inserted,
+    "updated_kl": sorted(updated_kl),
+    "updated_review": sorted(updated_review),
+    "updated_accuracy_only": sorted(updated_accuracy),
+    "counts": {
+        "inserted": len(inserted),
+        "updated_kl": len(updated_kl),
+        "updated_review": len(updated_review),
+        "updated_accuracy_only": len(updated_accuracy),
+        "charts": sum(name.startswith("xl/charts/") for name in names),
+        "drawings": sum(name.startswith("xl/drawings/") for name in names),
+        "media": sum(name.startswith("xl/media/") for name in names),
+        "max_row": ws.max_row,
+    },
+}
+(WORK / "fix_t09_accuracy_apply_audit_20261002.json").write_text(json.dumps(audit, ensure_ascii=False, indent=2), encoding="utf-8")
